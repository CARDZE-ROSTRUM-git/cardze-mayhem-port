# Upstream firmware (clone it, do not commit it) -- see README
/third_party/mayhem-firmware/
/third_party/*/
!/third_party/.gitkeep

# Build output
/build/
/cmake-build-*/
*.o
*.a
*.so
compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# The host binary (build it yourself)
/mayhem-desktop

# Emulated SD card runtime data (settings/captures/playlists are user data)
/mayhem-sd/

# Editor / OS noise
*.swp
*~
.vscode/
.idea/
.DS_Store
